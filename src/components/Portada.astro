---
// Portada.astro — sobre 3D que se abre al tocar el sello
// (la portada anterior quedó guardada en "Portada copy 3.astro")

// Destellos dorados del fondo
const destellos = Array.from({ length: 16 }, (_, i) => ({
    left: (i * 61 + 7) % 100,
    delay: ((i * 1.7) % 9).toFixed(1),
    duracion: (9 + ((i * 2.3) % 6)).toFixed(1),
    tamano: 2 + (i % 3),
}));
---

<section
    id="portada-sobre"
    class="fixed inset-0 w-full h-screen z-50 flex flex-col items-center justify-center gap-12 md:gap-14 overflow-hidden py-8"
>
    <!-- DESTELLOS DORADOS -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        {
            destellos.map((d) => (
                <span
                    class="destello"
                    style={`left:${d.left}%; width:${d.tamano}px; height:${d.tamano}px; animation-delay:-${d.delay}s; animation-duration:${d.duracion}s;`}
                />
            ))
        }
    </div>

    <!-- TEXTO SUPERIOR -->
    <div id="portada-texto-sup" class="relative text-center z-10 px-4">
        <h1
            class="font-crimson text-2xl md:text-3xl text-[#9a864a] font-semibold tracking-[0.3em] uppercase mb-2"
        >
            DALE CLICK
        </h1>
        <p
            class="font-crimson text-base md:text-lg text-[#5E6B4A] tracking-wider uppercase"
        >
            En el sello para abrir<br /> la invitación
        </p>
    </div>

    <!-- ESCENARIO 3D -->
    <div class="escenario relative z-10 w-full flex items-center justify-center">
        <div id="sobre3d" class="sobre3d">
            <!-- Sombra en el piso -->
            <div id="sobre-sombra" class="sobre-sombra"></div>

            <!-- Interior del sobre -->
            <div class="capa sobre-interior"></div>

            <!-- Carta -->
            <div id="sobre-carta" class="capa sobre-carta">
                <div class="carta-contenido">
                    <p class="font-crimson text-[0.62rem] sm:text-xs text-[#9a864a] uppercase tracking-[0.35em] pl-[0.35em]">
                        Nos casamos
                    </p>
                    <p class="font-great-vibes text-5xl sm:text-6xl text-[#4A5538] leading-tight mt-1">
                        S <span class="text-[#9a864a] text-4xl sm:text-5xl">&amp;</span> Y
                    </p>
                    <p class="font-crimson text-xs sm:text-sm text-[#5E6B4A] tracking-[0.25em] pl-[0.25em] mt-1">
                        31 · 10 · 2026
                    </p>
                </div>
                <div id="carta-brillo" class="carta-brillo"></div>
            </div>

            <!-- Bolsillo delantero (3 solapas fijas) -->
            <div class="capa bolsillo bolsillo-izq"></div>
            <div class="capa bolsillo bolsillo-der"></div>
            <div class="capa bolsillo sombra-suave"><div class="capa bolsillo-abajo"></div></div>

            <!-- Flores sobre el bolsillo -->
            <img src="/imagenes/florlateral.png" alt="" class="flor flor-izq" aria-hidden="true" />
            <img src="/imagenes/florlateral.png" alt="" class="flor flor-der" aria-hidden="true" />

            <!-- Solapa superior (se abre en 3D) -->
            <div id="sobre-solapa" class="capa solapa">
                <div class="solapa-cara sombra-suave"><div class="capa solapa-exterior"></div></div>
                <div class="solapa-cara solapa-interior"></div>
            </div>

            <!-- Sello de cera en la punta de la solapa -->
            <button id="btn-sello" class="sello" aria-label="Abrir la invitación">
                <span id="sello-halo" class="sello-halo"></span>
                <img id="sello-cera" src="/imagenes/boton.png" alt="" class="sello-svg" draggable="false" />
            </button>
        </div>
    </div>

    <!-- TEXTO INFERIOR -->
    <div id="portada-texto-inf" class="relative text-center z-10 px-4">
        <p
            class="font-crimson text-base md:text-lg text-[#9a864a] uppercase tracking-[0.3em] pl-[0.3em] mb-1"
        >
            Atentamente
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3 md:gap-4 px-4">
            <h2
                class="font-great-vibes text-4xl sm:text-5xl md:text-6xl text-[#4A5538] leading-normal"
            >
                Sergio
            </h2>
            <span class="font-charm text-3xl md:text-4xl text-[#9a864a]">&</span>
            <h2
                class="font-great-vibes text-4xl sm:text-5xl md:text-6xl text-[#4A5538] leading-normal"
            >
                Yessenia
            </h2>
        </div>
    </div>

    <!-- DESTELLO DE LUZ AL ABRIR -->
    <div id="portada-luz" class="portada-luz" aria-hidden="true"></div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const portada = document.getElementById("portada-sobre");
        const btnSello = document.getElementById("btn-sello");
        const sobre = document.getElementById("sobre3d");
        const solapa = document.getElementById("sobre-solapa");
        const carta = document.getElementById("sobre-carta");
        if (!portada || !btnSello || !sobre || !solapa || !carta) return;

        // ═══ ENTRADA ═══
        gsap.from(sobre, {
            y: 40,
            opacity: 0,
            rotationX: 25,
            duration: 1.6,
            ease: "power3.out",
        });
        gsap.from("#btn-sello", {
            scale: 0.6,
            opacity: 0,
            duration: 1.2,
            delay: 0.9,
            ease: "back.out(1.8)",
        });

        // ═══ FLOTADO 3D SUAVE ═══
        const flotado = gsap.timeline({ repeat: -1, yoyo: true, delay: 1.6 });
        flotado.to(sobre, {
            y: -10,
            rotationY: 7,
            rotationX: 5,
            duration: 3,
            ease: "sine.inOut",
        });
        const flotadoB = gsap.to(sobre, {
            rotationZ: 1.2,
            duration: 4.4,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
        });

        // ═══ RESPIRACIÓN DEL SELLO ═══
        const respiracion = gsap.to("#sello-cera", {
            scale: 1.05,
            transformOrigin: "50% 50%",
            duration: 2.2,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
        });

        let abierto = false;

        const abrir = () => {
            if (abierto) return;
            abierto = true;

            // Música
            const audio = new Audio("/musica/melodia.mp3");
            audio.loop = true;
            audio.volume = 0.5;
            audio.play().catch((error: any) => {
                console.log("Error al reproducir audio:", error);
            });
            (window as any).audioGlobal = audio;
            (window as any).estaReproduciendoGlobal = true;

            setTimeout(() => {
                const iconoPlay = document.getElementById("icono-play");
                const iconoPause = document.getElementById("icono-pause");
                if (iconoPlay && iconoPause) {
                    iconoPlay.classList.add("hidden");
                    iconoPause.classList.remove("hidden");
                }
            }, 100);

            flotado.kill();
            flotadoB.kill();
            respiracion.kill();

            const tl = gsap.timeline({ defaults: { ease: "power2.inOut" } });

            tl
                // El sobre queda de frente
                .to(sobre, { y: 0, rotationX: 0, rotationY: 0, rotationZ: 0, duration: 0.6 }, 0)
                // Luminancia del sello
                .to("#sello-halo", { scale: 2.6, opacity: 1, duration: 0.6, ease: "power2.out" }, 0)
                .to("#sello-cera", {
                    scale: 1.15,
                    filter: "brightness(1.35) drop-shadow(0 0 18px rgba(255, 226, 150, 0.95))",
                    duration: 0.5,
                    ease: "power2.out",
                }, 0)
                // El sello se desprende
                .to("#btn-sello", { scale: 0.4, opacity: 0, rotation: -25, y: 20, duration: 0.5, ease: "power2.in" }, 0.55)
                .to(["#portada-texto-sup", "#portada-texto-inf"], { opacity: 0, y: (i) => (i ? 20 : -20), duration: 0.6 }, 0.5)
                // Se abre la solapa
                .to(solapa, { rotationX: 180, duration: 1.1, ease: "power2.inOut" }, 0.9)
                .set(solapa, { zIndex: 1 }, 1.45)
                // Sale la carta
                .to(carta, { yPercent: -62, duration: 1.1, ease: "power3.out" }, 1.75)
                .fromTo("#carta-brillo", { xPercent: -120 }, { xPercent: 120, duration: 1.1, ease: "power1.inOut" }, 2.1)
                // La carta viene hacia adelante y todo se ilumina
                .set(carta, { zIndex: 6 }, 2.85)
                .to(carta, { yPercent: -20, scale: 1.45, duration: 1.1, ease: "power2.inOut" }, 2.85)
                .to(".sobre3d > :not(#sobre-carta)", { opacity: 0, y: 40, duration: 0.8 }, 2.85)
                .to("#portada-luz", { opacity: 1, scale: 1.4, duration: 1, ease: "power2.in" }, 3.1)
                .add(() => {
                    document.body.style.overflow = "auto";
                    window.scrollTo(0, 0);
                    reiniciarNombresFlores();
                }, 4.0)
                .to(portada, { opacity: 0, duration: 0.9, ease: "power2.out" }, 4.0)
                .add(() => portada.remove());
        };

        // Repite la entrada de NombresFlores, que ya corrió detrás de la portada
        const reiniciarNombresFlores = () => {
            const animaciones = ScrollTrigger.getAll()
                .filter((st) => {
                    const t = st.trigger as HTMLElement | undefined;
                    return t?.id === "sobre-container" || t?.id === "tarjetas-container";
                })
                .map((st) => st.animation)
                .filter((a): a is gsap.core.Animation => !!a);

            // El flotado de la foto se crea al terminar su entrada: se corta para que no choque
            gsap.getTweensOf("#sobre-imagen")
                .filter((t) => !animaciones.includes(t))
                .forEach((t) => t.kill());

            animaciones.forEach((a) => a.restart(true));
        };

        btnSello.addEventListener("click", abrir);
        sobre.addEventListener("click", abrir);
    });
</script>

<style>
    body {
        overflow: hidden;
    }

    #portada-sobre {
        background-image:
            radial-gradient(ellipse at 50% 45%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0) 60%),
            radial-gradient(ellipse at 50% 110%, rgba(154, 134, 74, 0.16) 0%, rgba(154, 134, 74, 0) 55%),
            url("/imagenes/BlancoTextura.png"),
            linear-gradient(#fbf8f1, #f2ecdf);
        background-size: auto, auto, contain, auto;
    }

    /* ═══ DESTELLOS ═══ */
    .destello {
        position: absolute;
        bottom: -10px;
        border-radius: 9999px;
        background-image: radial-gradient(circle, #f3dd9b 0%, rgba(201, 170, 90, 0.6) 55%, rgba(201, 170, 90, 0) 100%);
        animation: subir linear infinite;
        opacity: 0;
    }

    @keyframes subir {
        0% { transform: translateY(0) scale(0.6); opacity: 0; }
        15% { opacity: 0.9; }
        50% { transform: translateY(-50vh) translateX(12px) scale(1); opacity: 0.6; }
        85% { opacity: 0.8; }
        100% { transform: translateY(-105vh) translateX(-8px) scale(0.7); opacity: 0; }
    }

    /* ═══ SOBRE ═══ */
    .escenario {
        perspective: 1100px;
    }

    .sobre3d {
        --w: min(84vw, 400px);
        position: relative;
        width: var(--w);
        height: calc(var(--w) * 0.66);
        cursor: pointer;
        perspective: 900px;
        will-change: transform;
    }

    .capa {
        position: absolute;
        inset: 0;
    }

    .sobre-sombra {
        position: absolute;
        left: 8%;
        right: 8%;
        bottom: -14%;
        height: 14%;
        background-image: radial-gradient(ellipse at center, rgba(74, 85, 56, 0.28) 0%, rgba(74, 85, 56, 0) 70%);
        filter: blur(6px);
    }

    .sobre-interior {
        z-index: 1;
        border-radius: 6px;
        background-image: linear-gradient(180deg, #e6dcc5 0%, #efe7d4 100%);
        box-shadow: 0 18px 40px -18px rgba(74, 85, 56, 0.45);
    }

    .sobre-carta {
        z-index: 2;
        inset: 5% 5% 4% 5%;
        border-radius: 4px;
        background-image: linear-gradient(180deg, #fffdf8 0%, #f8f2e4 100%);
        box-shadow: 0 2px 10px rgba(74, 85, 56, 0.18);
        overflow: hidden;
        transform-origin: 50% 50%;
    }

    .sobre-carta::before {
        content: "";
        position: absolute;
        inset: 6px;
        border: 1px solid rgba(154, 134, 74, 0.45);
        border-radius: 2px;
    }

    .carta-contenido {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: 9%;
        text-align: center;
    }

    .carta-brillo {
        position: absolute;
        inset: -10% 0;
        background-image: linear-gradient(105deg, rgba(255, 255, 255, 0) 30%, rgba(255, 244, 210, 0.85) 50%, rgba(255, 255, 255, 0) 70%);
        transform: translateX(-120%);
        pointer-events: none;
    }

    .bolsillo {
        z-index: 3;
        border-radius: 6px;
    }

    .bolsillo-izq {
        clip-path: polygon(0 0, 52% 56%, 0 100%);
        background-image: linear-gradient(100deg, #f4eedf 0%, #ece3cf 100%);
    }

    .bolsillo-der {
        clip-path: polygon(100% 0, 48% 56%, 100% 100%);
        background-image: linear-gradient(260deg, #f4eedf 0%, #ece3cf 100%);
    }

    .bolsillo-abajo {
        clip-path: polygon(0 100%, 50% 44%, 100% 100%);
        background-image: linear-gradient(0deg, #f7f2e6 0%, #efe7d5 100%);
    }

    .flor {
        position: absolute;
        z-index: 3;
        height: 62%;
        width: auto;
        bottom: -6%;
        pointer-events: none;
    }

    .flor-izq {
        left: -7%;
        transform: rotate(-8deg);
    }

    .flor-der {
        right: -7%;
        transform: scaleX(-1) rotate(-8deg);
    }

    /* La sombra va en el contenedor: el clip-path del hijo la recortaría */
    .sombra-suave {
        filter: drop-shadow(0 2px 4px rgba(74, 85, 56, 0.2));
    }

    .solapa {
        z-index: 4;
        transform-origin: 50% 0;
        transform-style: preserve-3d;
    }

    .solapa-cara {
        position: absolute;
        inset: 0;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
    }

    .solapa-exterior {
        clip-path: polygon(0 0, 100% 0, 50% 64%);
        background-image: linear-gradient(180deg, #fbf7ee 0%, #f1e9d8 100%);
    }

    /* Triángulo invertido: al girar 180° queda en el mismo lugar que la cara exterior */
    .solapa-interior {
        clip-path: polygon(0 100%, 100% 100%, 50% 36%);
        background-image: linear-gradient(0deg, #e3d8bf 0%, #ece3cf 100%);
        transform: rotateX(180deg);
    }

    /* ═══ SELLO ═══ */
    .sello {
        position: absolute;
        z-index: 5;
        left: 50%;
        top: 64%;
        width: calc(var(--w) * 0.27);
        height: calc(var(--w) * 0.27);
        margin-left: calc(var(--w) * -0.135);
        margin-top: calc(var(--w) * -0.135);
        border: 0;
        padding: 0;
        background: none;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
    }

    .sello:focus {
        outline: none;
    }

    .sello-svg {
        position: relative;
        width: 100%;
        height: 100%;
        filter: drop-shadow(0 4px 6px rgba(74, 85, 56, 0.35));
    }

    .sello-halo {
        position: absolute;
        inset: -18%;
        border-radius: 9999px;
        background-image: radial-gradient(circle, rgba(255, 233, 170, 0.75) 0%, rgba(255, 233, 170, 0.25) 45%, rgba(255, 233, 170, 0) 70%);
        animation: halo 2.4s ease-in-out infinite;
        pointer-events: none;
    }

    @keyframes halo {
        0%, 100% { transform: scale(0.85); opacity: 0.35; }
        50% { transform: scale(1.15); opacity: 0.9; }
    }

    /* ═══ LUZ FINAL ═══ */
    .portada-luz {
        position: absolute;
        inset: -20%;
        z-index: 20;
        opacity: 0;
        pointer-events: none;
        background-image: radial-gradient(circle at 50% 45%, rgba(255, 255, 255, 1) 0%, rgba(255, 249, 232, 0.97) 35%, rgba(250, 238, 205, 0.9) 70%, rgba(245, 230, 190, 0.85) 100%);
    }

    @media (prefers-reduced-motion: reduce) {
        .destello,
        .sello-halo {
            animation: none;
        }
    }
</style>
