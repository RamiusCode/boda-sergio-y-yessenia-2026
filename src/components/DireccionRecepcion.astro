<!-- 🎨 ESTILOS CSS                                              -->
<!-- ═══════════════════════════════════════════════════════════ -->
<style>
    /* Color de textos #122a4d */
    .texto-recepcion {
        color: #5E6B4A;
    }

    /* Hora en dorado */
    .hora-dorada-recepcion {
        color: #9a864a;
    }

    /* Color del icono de copa */
    .icono-recepcion-color {
        filter: brightness(0) saturate(100%) invert(40%) sepia(20%)
            saturate(600%) hue-rotate(65deg) brightness(90%) contrast(85%);
    }

    /* Botón con color dorado */
    .btn-ubicacion-recepcion {
        color: #9a864a;
        border-color: #9a864a;
    }

    .btn-ubicacion-recepcion:hover {
        background-color: #9a864a;
        color: white;
        transform: scale(1.05);
        box-shadow: 0 5px 15px rgba(18, 42, 77, 0.3);
    }

    /* Caja de la nota "3 días en el mismo lugar" */
    .nota-recepcion-caja {
        border-color: rgba(154, 134, 74, 0.45);
        background-color: rgba(255, 255, 255, 0.35);
    }

    /* Efecto hover en la card */
    #card-recepcion > div {
        transition: all 0.4s ease;
        transform-style: preserve-3d;
    }

