<!-- ═══════════════════════════════════════════════════════════ --><!-- 🥂 SECCIÓN: RECEPCIÓN SOCIAL                               --><!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full pt-20 pb-12 sm:py-24 md:py-28 lg:py-36">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- 📇 CARD DE RECEPCIÓN - HORIZONTAL -->
        <div class="flex justify-center">
            <div
                class="relative w-full max-w-md sm:max-w-lg md:max-w-xl"
                id="card-recepcion"
            >
                <!-- BOTÓN DECORATIVO SUPERIOR -->
                <div
                    class="absolute z-20"
                    style="top: -30px; left: 50%; transform: translateX(-50%);"
                >
                    <div class="w-16 h-16" id="boton-decorativo-recepcion">
                        <img
                            src="/imagenes/boton.png"
                            alt="Decoración"
                            class="w-full h-full object-contain"
                        />
                    </div>
                </div>

                <div
                    class="relative rounded-2xl shadow-xl overflow-hidden"
                    style="background-color: #e8dcc8;"
                >
                    <!-- IMAGEN DE FONDO -->
                    <img
                        src="/imagenes/fondorojo.png"
                        alt="Fondo recepción"
                        class="absolute inset-0 w-full h-full object-cover opacity-90"
                    />

                    <!-- Contenido de la card - LAYOUT CON TÍTULO EXTENDIDO -->
                    <div
                        class="relative px-4 pt-14 pb-8 sm:px-8 sm:pt-16 sm:pb-10 md:px-10 md:pt-16 md:pb-12 z-10"
                    >
                        <!-- TÍTULO: RECEPCIÓN SOCIAL - OCUPA TODO EL ANCHO -->
                        <div class="mb-2">
                            <h2
                                class="font-great-vibes text-4xl sm:text-4xl md:text-5xl text-[#9a864a] text-center"
                                id="titulo-recepcion"
                            >
                                Recepción Social
                            </h2>
                        </div>

                        <!-- CONTENIDO INFERIOR CON ICONO Y TEXTOS -->
                        <div class="flex items-center justify-between gap-4">
                            <!-- LADO IZQUIERDO: ICONO DE COPA -->
                            <div class="flex-shrink-0 ml-4 sm:ml-6 md:ml-8">
                                <div
                                    class="w-24 h-24 sm:w-20 sm:h-20 md:w-24 md:h-24 icono-recepcion-color"
                                >
                                    <img
                                        src="/imagenes/recepcion.png"
                                        alt="Copa"
                                        class="w-full h-full object-contain"
                                        id="icono-copa"
                                    />
                                </div>
                            </div>

                            <!-- LADO DERECHO: TEXTOS Y BOTÓN -->
                            <div class="flex-1 text-center">
                                <!-- NOMBRE DEL SALÓN -->
                                <div class="mb-2">
                                    <p
                                        class="font-crimson text-xl sm:text-lg md:text-xl texto-recepcion font-semibold"
                                        id="nombre-salon"
                                    >
                                        Local<br />La Palmera
                                    </p>
                                </div>

                                <!-- DIRECCIÓN -->
                                <div class="mb-2 leading-tight">
                                    <p
                                        class="font-crimson text-xl sm:text-sm md:text-base texto-recepcion"
                                        id="direccion-salon"
                                    >
                                        B/ Tabladita II, Pasaje 2<br />El Churqui, esq. Av.<br />Héroes de la Tablada
                                    </p>
                                </div>

                                <!-- HORA -->
                                <div class="mb-4">
                                    <p
                                        class="font-crimson text-xl sm:text-base md:text-lg leading-tight hora-dorada-recepcion font-semibold"
                                        id="hora-recepcion"
                                    >
                                        Hora: 15:00 p. m.
                                    </p>
                                </div>

                                <!-- BOTÓN VER UBICACIÓN -->
                                <div class="mt-4">
                                    <a
                                        href="https://maps.app.goo.gl/MoffpgbKk86mbbg86"
                                        class="inline-block px-4 py-2 sm:px-6 sm:py-2.5 border-2 rounded-full font-crimson text-base sm:text-sm uppercase tracking-wider transition-all duration-300 btn-ubicacion-recepcion font-semibold"
                                        id="btn-ubicacion-recepcion"
                                    >
                                        VER UBICACIÓN
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- 🌿 RAMA SUPERIOR IZQUIERDA -->
                <img
                    src="/imagenes/floresverde.png"
                    alt=""
                    aria-hidden="true"
                    id="flor-izquierda-recepcion"
                    class="pointer-events-none select-none absolute w-[42%] sm:w-[38%] z-10"
                    style="top: -10%; left: -20%;"
                />

                <!-- 🌿 RAMA INFERIOR DERECHA (simetría de 180°) -->
                <img
                    src="/imagenes/floresverde.png"
                    alt=""
                    aria-hidden="true"
                    id="flor-derecha-recepcion"
                    class="pointer-events-none select-none absolute w-[42%] sm:w-[38%] z-10 rotate-180"
                    style="bottom: -10%; right: -20%;"
                />
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    if (typeof window !== "undefined") {
        document.addEventListener("DOMContentLoaded", () => {
            console.log("🥂 Iniciando animaciones de recepción...");

            // 🎯 BOTÓN DECORATIVO
            gsap.fromTo(
                "#boton-decorativo-recepcion",
                { opacity: 0, scale: 0, rotation: -180 },
                {
                    opacity: 1,
                    scale: 1,
                    rotation: 0,
                    duration: 1,
                    ease: "back.out(1.7)",
                    scrollTrigger: {
                        trigger: "#card-recepcion",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            // 🎯 ANIMACIÓN ELEGANTE DE ENTRADA - TODO AL MISMO TIEMPO
            gsap.fromTo(
                "#card-recepcion",
                {
                    opacity: 0,
                    scale: 0.85,
                    y: 60,
                    rotationY: -15,
                },
                {
                    opacity: 1,
                    scale: 1,
                    y: 0,
                    rotationY: 0,
                    duration: 1.2,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: "#card-recepcion",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            // ✨ ENTRADA ESCALONADA DE CADA ELEMENTO DE LA CARD
            // Cada uno tiene su propio matiz, pero se solapan entre sí
            // para que se lea como un solo movimiento fluido.
            const tlRecepcion = gsap.timeline({
                defaults: { ease: "power3.out" },
                scrollTrigger: {
                    trigger: "#card-recepcion",
                    start: "top 80%",
                    toggleActions: "play none none reset",
                },
            });

            tlRecepcion
                // 🥂 Título: desciende suave y se asienta
                .fromTo(
                    "#titulo-recepcion",
                    { opacity: 0, y: -28, scale: 0.94 },
                    { opacity: 1, y: 0, scale: 1, duration: 1.4 },
                    0.45,
                )
                // 🍾 Icono: aparece creciendo, con un giro mínimo
                .fromTo(
                    "#icono-copa",
                    { opacity: 0, scale: 0.6, rotation: -8 },
                    {
                        opacity: 1,
                        scale: 1,
                        rotation: 0,
                        duration: 1.3,
                        ease: "back.out(1.4)",
                    },
                    0.75,
                )
                // 🏛️ Nombre del salón
                .fromTo(
                    "#nombre-salon",
                    { opacity: 0, y: 18 },
                    { opacity: 1, y: 0, duration: 1.1 },
                    0.9,
                )
                // 📍 Dirección
                .fromTo(
                    "#direccion-salon",
                    { opacity: 0, y: 18 },
                    { opacity: 1, y: 0, duration: 1.1 },
                    1.05,
                )
                // 🕓 Hora
                .fromTo(
                    "#hora-recepcion",
                    { opacity: 0, y: 18 },
                    { opacity: 1, y: 0, duration: 1.1 },
                    1.2,
                )
                // 🔘 Botón: cierra la secuencia con un latido sutil
                .fromTo(
                    "#btn-ubicacion-recepcion",
                    { opacity: 0, y: 14, scale: 0.9 },
                    {
                        opacity: 1,
                        y: 0,
                        scale: 1,
                        duration: 1.2,
                        ease: "back.out(1.6)",
                    },
                    1.4,
                );

            console.log("🥂✨ ¡Animaciones de recepción activadas!");

            // 🌿 RAMA IZQUIERDA: entra deslizándose desde la izquierda
            gsap.fromTo(
                "#flor-izquierda-recepcion",
                {
                    opacity: 0,
                    x: -90,
                    scale: 0.92,
                },
                {
                    opacity: 1,
                    x: 0,
                    scale: 1,
                    duration: 1.6,
                    delay: 0.35,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: "#card-recepcion",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            // 🌿 RAMA DERECHA: entra deslizándose desde la derecha
            // (rotation: 180 se mantiene fija para conservar la simetría)
            gsap.fromTo(
                "#flor-derecha-recepcion",
                {
                    opacity: 0,
                    x: 90,
                    scale: 0.92,
                    rotation: 180,
                },
                {
                    opacity: 1,
                    x: 0,
                    scale: 1,
                    rotation: 180,
                    duration: 1.6,
                    delay: 0.35,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: "#card-recepcion",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );
        });
    }
</script>

