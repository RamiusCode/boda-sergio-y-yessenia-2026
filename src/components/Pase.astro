---
// Pase.astro
interface Props {
    numeroPases: number;
    nombreInvitado?: string;
}

import { palabraPases, frasePases } from "../lib/pase";

const { numeroPases = 1, nombreInvitado = "" } = Astro.props;
---

<section class="relative w-full pt-10 pb-10 sm:py-20 md:py-24 lg:py-32">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-center">
            <div class="relative w-[300px]" id="card-pase">

                <!-- BOTÓN DECORATIVO SUPERIOR -->
                <div
                    class="absolute z-20"
                    style="top: -30px; left: 50%; transform: translateX(-50%);"
                >
                    <div class="w-16 h-16" id="boton-decorativo-pase">
                        <img
                            src="/imagenes/boton.png"
                            alt="Decoración"
                            class="w-full h-full object-contain"
                        />
                    </div>
                </div>

                <!-- CARD PRINCIPAL -->
                <div
                    class="relative rounded-2xl shadow-xl overflow-hidden bg-[#f5f5f5]"
                    id="card-principal-pase"
                >
                    <!-- IMAGEN DE FONDO -->
                    <img
                        src="/imagenes/fondoplomo.png"
                        alt="Fondo pase"
                        class="absolute inset-0 w-full h-full object-cover"
                    />

                    <!-- VELO BLANCO: mismo tono que las tarjetas de NombresFlores -->
                    <div class="absolute inset-0 bg-white/40"></div>
                    <div
                        class="absolute top-0 left-0 right-0 h-24 bg-gradient-to-b from-white/20 to-transparent"
                    >
                    </div>

                    <!-- Contenido de la card -->
                    <div class="relative px-6 pt-16 pb-10 z-10 text-center">

                        <!-- DEDICATORIA AL INVITADO: escondida hasta que el link traiga nombre -->
                        <div
                            class="mb-8"
                            id="dedicatoria-pase"
                            style={nombreInvitado ? undefined : "display: none;"}
                        >
                            <p class="font-crimson text-base uppercase tracking-widest text-[#9a864a] font-semibold mb-3">
                                Con mucho cariño para:
                            </p>
                            <p
                                id="nombre-invitado"
                                class="font-great-vibes text-[2rem] text-[#4A5538] leading-tight wrap-break-word"
                            >
                                {nombreInvitado}
                            </p>
                        </div>

                        <!-- TÍTULO -->
                        <div class="mb-6" id="titulo-pase">
                            <h2
                                class="font-great-vibes text-[2.5rem] text-[#5E6B4A] leading-none mb-2"
                            >
                                Pases
                            </h2>
                            <p
                                class="font-crimson text-sm uppercase tracking-widest text-[#9a864a] font-semibold"
                            >
                                ASIGNADOS
                            </p>
                        </div>

                        <!-- NÚMERO DE PASES -->
                        <div class="mb-4" id="numero-pase">
                            <p
                                id="numero-pases"
                                class="font-charm text-[#9a864a] font-bold leading-none"
                                style="font-size: 5rem;"
                            >
                                {numeroPases}
                            </p>
                            <p
                                id="palabra-pases"
                                class="font-crimson text-base uppercase tracking-[0.3em] text-[#5E6B4A] mt-1"
                            >
                                {palabraPases(numeroPases)}
                            </p>
                        </div>

                        <!-- SEPARADOR -->
                        <div class="flex items-center justify-center gap-2 my-4" id="separador-pase">
                            <div class="w-10 h-px bg-[#5E6B4A]/30"></div>
                            <div class="w-1.5 h-1.5 rounded-full bg-[#9a864a]/60"></div>
                            <div class="w-10 h-px bg-[#5E6B4A]/30"></div>
                        </div>

                        <!-- TEXTO DESCRIPTIVO -->
                        <div id="texto-pase">
                            <p
                                id="frase-pases"
                                class="font-cormorant-sc text-lg leading-relaxed text-[#5E6B4A]"
                            >
                                {frasePases(numeroPases)}
                            </p>
                        </div>

                        <!-- ICONOS DE PERSONAS -->
                        <div class="flex justify-center gap-3 mt-6" id="iconos-pase">
                            {
                                Array.from({ length: numeroPases }).map((_, index) => (
                                    <div
                                        class="w-9 h-9 rounded-full bg-[#5E6B4A]/10 border border-[#5E6B4A]/30 flex items-center justify-center"
                                        style={`animation-delay: ${index * 0.2}s;`}
                                    >
                                        <svg
                                            class="w-5 h-5 text-[#5E6B4A]"
                                            fill="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                                        </svg>
                                    </div>
                                ))
                            }
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { datosInvitado, alCambiarInvitado } from "../lib/invitado";
    import type { Invitado } from "../lib/invitado";
    import { palabraPases, frasePases } from "../lib/pase";

    gsap.registerPlugin(ScrollTrigger);

    // ═══════════════════════════════════════════════════════════
    // PASE PERSONALIZADO
    // El link trae solo un código (?i=k7m2p); el nombre y los pases viven
    // en la base. Sin código la tarjeta queda como la armó el servidor.
    // ═══════════════════════════════════════════════════════════
    function pintarPase(nombre: string | null, pases: number | null) {
        if (nombre) {
            const el = document.getElementById("nombre-invitado");
            if (el) el.textContent = nombre;
            const dedicatoria = document.getElementById("dedicatoria-pase");
            if (dedicatoria) dedicatoria.style.display = "";
        }
        if (pases !== null && Number.isInteger(pases) && pases > 0) {
            const num = document.getElementById("numero-pases");
            const palabra = document.getElementById("palabra-pases");
            const frase = document.getElementById("frase-pases");
            if (num) num.textContent = String(pases);
            if (palabra) palabra.textContent = palabraPases(pases);
            if (frase) frase.textContent = frasePases(pases);

            // Un monigote por pase
            const iconos = document.getElementById("iconos-pase");
            const molde = iconos?.firstElementChild;
            if (iconos && molde && iconos.children.length !== pases) {
                iconos.innerHTML = "";
                for (let i = 0; i < pases; i++) {
                    const copia = molde.cloneNode(true) as HTMLElement;
                    copia.style.animationDelay = i * 0.2 + "s";
                    iconos.append(copia);
                }
            }
        }
        // La tarjeta cambió de alto: las animaciones de más abajo tienen
        // que recalcular dónde arrancan.
        ScrollTrigger.refresh();
    }

    function mostrarInvitado(inv: Invitado | null) {
        if (!inv) return;
        // Boda sin pases: la tarjeta queda solo con el nombre, sin un
        // "1 pase" inventado.
        if (inv.funciones && inv.funciones.pases === false) {
            for (const id of [
                "titulo-pase",
                "numero-pase",
                "separador-pase",
                "texto-pase",
                "iconos-pase",
            ]) {
                const el = document.getElementById(id);
                if (el) el.style.display = "none";
            }
            pintarPase(inv.nombre, null);
            return;
        }
        pintarPase(inv.nombre, inv.pases);
    }

    if (typeof window !== "undefined") {
        datosInvitado().then(mostrarInvitado);
        // Si los novios corrigen el nombre o los pases con la invitación
        // abierta, la tarjeta se actualiza sola.
        alCambiarInvitado(mostrarInvitado);

        document.addEventListener("DOMContentLoaded", () => {
            gsap.fromTo(
                "#boton-decorativo-pase",
                { opacity: 0, scale: 0, rotation: -180 },
                {
                    opacity: 1,
                    scale: 1,
                    rotation: 0,
                    duration: 1,
                    ease: "back.out(1.7)",
                    scrollTrigger: {
                        trigger: "#card-pase",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            gsap.fromTo(
                "#card-principal-pase",
                { opacity: 0, y: 50, scale: 0.95 },
                {
                    opacity: 1,
                    y: 0,
                    scale: 1,
                    duration: 1,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: "#card-pase",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            if (document.querySelector("#dedicatoria-pase")) {
                gsap.fromTo(
                    "#dedicatoria-pase",
                    { opacity: 0, y: -20 },
                    {
                        opacity: 1,
                        y: 0,
                        duration: 0.8,
                        ease: "power2.out",
                        scrollTrigger: {
                            trigger: "#card-pase",
                            start: "top 80%",
                            toggleActions: "play none none reset",
                        },
                    },
                );
            }

            gsap.fromTo(
                "#titulo-pase",
                { opacity: 0, y: -20 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.8,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: "#card-pase",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            gsap.fromTo(
                "#numero-pase",
                { opacity: 0, scale: 0.8 },
                {
                    opacity: 1,
                    scale: 1,
                    duration: 1,
                    delay: 0.2,
                    ease: "back.out(1.4)",
                    scrollTrigger: {
                        trigger: "#card-pase",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            gsap.fromTo(
                "#texto-pase",
                { opacity: 0, y: 20 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.6,
                    delay: 0.4,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: "#card-pase",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            gsap.fromTo(
                "#iconos-pase",
                { opacity: 0, y: 20 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.6,
                    delay: 0.6,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: "#card-pase",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );
        });
    }
</script>
