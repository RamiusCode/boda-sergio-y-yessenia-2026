<!-- 🎬 ANIMACIONES CON GSAP - SOLO UNA VEZ AL BAJAR            -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    if (typeof window !== "undefined") {
        document.addEventListener("DOMContentLoaded", () => {
            // Animación del botón decorativo
            gsap.fromTo(
                "#boton-decorativo-itinerario",
                {
                    opacity: 0,
                    scale: 0,
                    rotation: -180,
                },
                {
                    opacity: 1,
                    scale: 1,
                    rotation: 0,
                    duration: 1,
                    ease: "back.out(1.7)",
                    scrollTrigger: {
                        trigger: "#card-itinerario",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            // Animación de la card
            gsap.fromTo(
                "#card-principal-itinerario",
                {
                    opacity: 0,
                    y: 50,
                    scale: 0.95,
                },
                {
                    opacity: 1,
                    y: 0,
                    scale: 1,
                    duration: 1,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: "#card-itinerario",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            // ✨ ENTRADA ESCALONADA: cada elemento con su propio matiz,
            // solapados entre sí para que se lea como un solo movimiento.
            const tlItinerario = gsap.timeline({
                defaults: { ease: "power3.out" },
                scrollTrigger: {
                    trigger: "#card-itinerario",
                    start: "top 80%",
                    toggleActions: "play none none reset",
                },
            });

            // Título: desciende suave y se asienta
            tlItinerario.fromTo(
                "#titulo-itinerario",
                { opacity: 0, y: -28, scale: 0.94 },
                { opacity: 1, y: 0, scale: 1, duration: 1.4 },
                0.45,
            );

            // Cada evento: el icono crece y el texto se desliza desde la izquierda
            const eventos = [
                "#evento-1",
                "#evento-2",
                "#evento-3",
                "#evento-4",
                "#evento-5",
                "#evento-6",
                "#evento-7",
            ];

            eventos.forEach((evento, index) => {
                const t = 0.7 + index * 0.14;

                tlItinerario
                    .fromTo(
                        `${evento} img`,
                        { opacity: 0, scale: 0.55, rotation: -8 },
                        {
                            opacity: 1,
                            scale: 1,
                            rotation: 0,
                            duration: 1.2,
                            ease: "back.out(1.4)",
                        },
                        t,
                    )
                    .fromTo(
                        `${evento} > div:last-child`,
                        { opacity: 0, x: -26 },
                        { opacity: 1, x: 0, duration: 1.2 },
                        t + 0.06,
                    );
            });

            // 🌿 RAMA IZQUIERDA: entra deslizándose desde la izquierda
            gsap.fromTo(
                "#flor-izquierda-itinerario",
                {
                    opacity: 0,
                    x: -90,
                    scale: 0.92,
                },
                {
                    opacity: 1,
                    x: 0,
                    scale: 1,
                    duration: 1.6,
                    delay: 0.35,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: "#card-itinerario",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            // 🌿 RAMA DERECHA: entra deslizándose desde la derecha
            // (rotation: 180 se mantiene fija para conservar la simetría)
            gsap.fromTo(
                "#flor-derecha-itinerario",
                {
                    opacity: 0,
                    x: 90,
                    scale: 0.92,
                    rotation: 180,
                },
                {
                    opacity: 1,
                    x: 0,
                    scale: 1,
                    rotation: 180,
                    duration: 1.6,
                    delay: 0.35,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: "#card-itinerario",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );
        });
    }
</script>
